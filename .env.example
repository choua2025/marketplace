# Copy this file to .env and fill in real values for local development.
# Variables are grouped by the milestone that introduces them (see PLAN.md).
# The running Next.js server only validates (via src/server/lib/env.ts) the
# variables its current code actually reads -- the schema grows milestone
# by milestone, but every variable the project will ever need is listed
# here upfront so `docker compose up` works from day one.

# ---------------------------------------------------------------------------
# App (M0)
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app. Used for OAuth callbacks, OG tags, sitemap.xml.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL -- docker-compose bootstrap (M0) + connection strings (M1)
# ---------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD is the superuser the official postgres image creates
# on first boot. It is only ever used internally by docker-entrypoint-initdb.d
# to create the two least-privilege roles below -- the app never connects
# with it (SPEC.md section 5.7).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_postgres_superuser_password
POSTGRES_DB=changdee
POSTGRES_TEST_DB=changdee_test
# Non-default port: 5432/5433 are commonly already in use by a native
# Postgres install on dev machines.
POSTGRES_PORT=55432

# Owner role: owns both databases, can run DDL (CREATE TABLE/EXTENSION/
# TRIGGER). Used only by drizzle-kit, db:migrate, and db:seed -- never by
# the running app.
DB_OWNER_USER=changdee_owner
DB_OWNER_PASSWORD=dev_owner_password

# App role: DML only (SELECT/INSERT/UPDATE/DELETE), no DDL, not superuser.
# This is the role the running Next.js server connects with at runtime.
DB_APP_USER=changdee_app
DB_APP_PASSWORD=dev_app_password

# Migration/seed connection (owner role, DDL rights) -- read by
# drizzle.config.ts, db:migrate, db:seed. Added in M1.
DATABASE_URL=postgres://changdee_owner:dev_owner_password@localhost:55432/changdee
# Runtime connection (app role, DML only) -- read by src/server/db/client.ts
# and validated in src/server/lib/env.ts. Added in M1.
DATABASE_APP_URL=postgres://changdee_app:dev_app_password@localhost:55432/changdee

# Same pair, pointed at the throwaway test database. Read only by
# tests/helpers (Vitest integration tests), never by the app server.
DATABASE_TEST_URL=postgres://changdee_owner:dev_owner_password@localhost:55432/changdee_test
DATABASE_TEST_APP_URL=postgres://changdee_app:dev_app_password@localhost:55432/changdee_test

# ---------------------------------------------------------------------------
# Auth -- Better Auth (M2)
# ---------------------------------------------------------------------------
# Random 32+ byte secret used to sign sessions/CSRF tokens. Generate with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# S3-compatible storage (M3)
# ---------------------------------------------------------------------------
# Dev: Garage (docker-compose, see docker/garage/). Prod: Cloudflare R2 or
# AWS S3 -- only these values change, application code is identical.
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=garage
# DEV ONLY: fixed Garage keys imported by docker/garage/init.sh. Never reuse in production.
S3_ACCESS_KEY_ID=GK61EAE273B65B23F63D926D42
S3_SECRET_ACCESS_KEY=06a84d47f18db1a2193982c2e718befb0d2beb9e7ebd82c82b72d6063b12672b
S3_BUCKET=changdee
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# SMS OTP (M2)
# ---------------------------------------------------------------------------
# NODE_ENV=development uses the console SmsProvider (prints OTP to the
# server log, no credentials needed). A real provider's credentials will be
# added here once one is selected for production -- not needed for MVP.
# Production (NODE_ENV=production): Twilio. All three required for phone login.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number (E.164, e.g. +15551234567) or a Messaging Service SID.
TWILIO_FROM=
